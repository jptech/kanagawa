{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2020",
    "outDir": "out/test",
    "lib": [
      "es2020",
      "dom"
    ],
    "sourceMap": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": [
    "test/**/*",
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    ".vscode-test"
  ]
}
