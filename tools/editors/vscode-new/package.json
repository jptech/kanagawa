{
  "name": "kanagawa-vscode",
  "displayName": "Kanagawa Language Support",
  "description": "IDE features for the Kanagawa hardware description language: navigation, completion, hover, and more.",
  "version": "0.1.0",
  "publisher": "microsoft",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jptech/kanagawa"
  },
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Snippets"
  ],
  "keywords": [
    "kanagawa",
    "hardware",
    "HDL",
    "FPGA",
    "hardware description language"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "kanagawa",
        "aliases": [
          "Kanagawa",
          "kanagawa"
        ],
        "extensions": [
          ".k",
          ".pd"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "commands": [
      {
        "command": "kanagawa.index.rebuild",
        "title": "Rebuild Index",
        "category": "Kanagawa"
      },
      {
        "command": "kanagawa.index.showStats",
        "title": "Show Index Statistics",
        "category": "Kanagawa"
      },
      {
        "command": "kanagawa.outline.selectCategories",
        "title": "Filter Outline by Category",
        "category": "Kanagawa"
      },
      {
        "command": "kanagawa.outline.setModulePrefix",
        "title": "Filter Outline by Module",
        "category": "Kanagawa"
      },
      {
        "command": "kanagawa.outline.clearModulePrefix",
        "title": "Clear Outline Module Filter",
        "category": "Kanagawa"
      },
      {
        "command": "kanagawa.deps.showCurrent",
        "title": "Show Module Dependencies",
        "category": "Kanagawa"
      },
      {
        "command": "kanagawa.deps.showFull",
        "title": "Show Full Dependency Graph",
        "category": "Kanagawa"
      },
      {
        "command": "kanagawa.deps.showInteractive",
        "title": "Browse Module Dependencies",
        "category": "Kanagawa"
      },
      {
        "command": "kanagawa.diagnostics",
        "title": "Show Diagnostics",
        "category": "Kanagawa"
      },
      {
        "command": "kanagawa.restart",
        "title": "Restart Extension",
        "category": "Kanagawa"
      },
      {
        "command": "kanagawa.openConfig",
        "title": "Open Project Configuration",
        "category": "Kanagawa"
      },
      {
        "command": "kanagawa.index.clear",
        "title": "Clear Index",
        "category": "Kanagawa",
        "enablement": "config.kanagawa.developerMode"
      },
      {
        "command": "kanagawa.index.toggleVerbose",
        "title": "Toggle Verbose Index Logging",
        "category": "Kanagawa",
        "enablement": "config.kanagawa.developerMode"
      },
      {
        "command": "kanagawa.perf.toggle",
        "title": "Toggle Performance Logging",
        "category": "Kanagawa",
        "enablement": "config.kanagawa.developerMode"
      },
      {
        "command": "kanagawa.perf.showSummary",
        "title": "Show Performance Summary",
        "category": "Kanagawa",
        "enablement": "config.kanagawa.developerMode"
      },
      {
        "command": "kanagawa.perf.clear",
        "title": "Clear Performance Stats",
        "category": "Kanagawa",
        "enablement": "config.kanagawa.developerMode"
      },
      {
        "command": "kanagawa.perf.setThreshold",
        "title": "Set Slow Operation Threshold",
        "category": "Kanagawa",
        "enablement": "config.kanagawa.developerMode"
      },
      {
        "command": "kanagawa.debugParseTree",
        "title": "Debug: Show Parse Tree",
        "category": "Kanagawa",
        "enablement": "config.kanagawa.developerMode"
      },
      {
        "command": "kanagawa.typePeek.show",
        "title": "Show Inferred Type",
        "category": "Kanagawa",
        "enablement": "false"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "kanagawa.config.json",
        "url": "./kanagawa.config.schema.json"
      }
    ],
    "configuration": {
      "title": "Kanagawa",
      "properties": {
        "kanagawa.developerMode": {
          "type": "boolean",
          "order": 0,
          "default": false,
          "markdownDescription": "Enable developer commands for debugging and performance analysis. When enabled, additional commands appear in the Command Palette for parse tree inspection, verbose logging, and performance profiling."
        },
        "kanagawa.compiler.importPaths": {
          "type": "array",
          "scope": "resource",
          "order": 1,
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Additional search paths for Kanagawa imports. Relative paths are resolved against the workspace folder.\n\n**Merged** with `kanagawa.config.json` entries (both sources are combined)."
        },
        "kanagawa.compiler.stdlibPath": {
          "type": "string",
          "scope": "resource",
          "order": 2,
          "default": "",
          "markdownDescription": "Standard library location. Relative paths are resolved against the workspace folder.\n\n**Overrides** `kanagawa.config.json` if set here."
        },
        "kanagawa.index.exclude": {
          "type": "array",
          "scope": "resource",
          "order": 3,
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Glob patterns for files and folders to exclude from indexing. Patterns are matched against paths relative to the workspace folder.\n\n**Merged** with `kanagawa.config.json` entries.\n\nExamples: `**/generated/**`, `**/*.gen.k`, `test_vectors/**`"
        },
        "kanagawa.inlayHints.typeHints.enabled": {
          "type": "boolean",
          "order": 10,
          "default": true,
          "markdownDescription": "Show inferred type hints for `auto` variable declarations.\n\nExample: `auto x = getValue();` shows `: int32` after `x`."
        },
        "kanagawa.inlayHints.parameterNames.enabled": {
          "type": "boolean",
          "order": 11,
          "default": true,
          "markdownDescription": "Show parameter name hints at function call sites.\n\nExample: `process(data, true)` shows `buffer:` and `async:` before arguments."
        },
        "kanagawa.inlayHints.templateParameterNames.enabled": {
          "type": "boolean",
          "order": 12,
          "default": true,
          "markdownDescription": "Show template parameter name hints at template instantiation sites.\n\nExample: `Vector<int32, 16>` shows `T:` and `N:` before arguments."
        },
        "kanagawa.signatureHelp.templateParameters.enabled": {
          "type": "boolean",
          "order": 13,
          "default": true,
          "markdownDescription": "Show template parameter signature help when typing template arguments (triggered by `<`)."
        },
        "kanagawa.outline.categoryFilter": {
          "type": "array",
          "order": 20,
          "items": {
            "type": "string",
            "enum": [
              "module",
              "class",
              "struct",
              "union",
              "enum",
              "function",
              "method",
              "variable",
              "member",
              "constant",
              "alias",
              "other"
            ],
            "enumDescriptions": [
              "Module declarations",
              "Class definitions",
              "Struct definitions",
              "Union definitions",
              "Enum definitions",
              "Function definitions",
              "Method definitions (inside classes)",
              "Variable declarations",
              "Member fields (inside classes/structs)",
              "Constant declarations",
              "Type aliases",
              "Other symbols"
            ]
          },
          "default": [],
          "markdownDescription": "Filter which symbol categories appear in the document outline. Leave empty to show all categories.\n\nUse the command `Kanagawa: Select Outline Categories` for an interactive picker."
        },
        "kanagawa.outline.modulePrefix": {
          "type": "string",
          "order": 21,
          "default": "",
          "markdownDescription": "Only show symbols whose module path starts with this prefix.\n\nExample: `data.` shows only symbols from `data.*` modules."
        },
        "kanagawa.typePeek.enabled": {
          "type": "boolean",
          "order": 30,
          "default": false,
          "markdownDescription": "Show `type: ...` CodeLens above `auto` variable declarations.\n\nDisabled by default since inlay hints provide the same information inline."
        },
        "kanagawa.performance.debounceDelay": {
          "type": "number",
          "order": 40,
          "default": 200,
          "minimum": 50,
          "maximum": 2000,
          "markdownDescription": "Delay (in milliseconds) before processing document changes. Higher values reduce CPU usage during rapid typing but increase latency.\n\nDefault: 200ms"
        },
        "kanagawa.performance.memberCacheLimit": {
          "type": "number",
          "order": 41,
          "default": 500,
          "minimum": 100,
          "maximum": 10000,
          "markdownDescription": "Maximum number of member resolution results to cache. Higher values improve performance for large workspaces but use more memory.\n\nDefault: 500 entries"
        },
        "kanagawa.performance.indexChunkSize": {
          "type": "number",
          "order": 42,
          "default": 10,
          "minimum": 1,
          "maximum": 50,
          "markdownDescription": "Number of files to process in each indexing batch. Higher values speed up initial indexing but may cause UI stuttering.\n\nDefault: 10 files per batch"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "compile:test": "tsc -p ./tsconfig.test.json",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run compile:test",
    "lint": "eslint src --ext ts",
    "test": "mocha ./out/test/**/*.test.js --timeout 10000",
    "test:grammar": "cd grammar && npx tree-sitter test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.1",
    "@types/node": "20.x",
    "@types/vscode": "^1.95.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vscode/test-electron": "^2.4.0",
    "chai": "^6.2.1",
    "eslint": "^9.0.0",
    "mocha": "^10.7.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.48.0"
  },
  "dependencies": {
    "web-tree-sitter": "^0.20.8"
  }
}
