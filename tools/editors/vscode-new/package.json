{
  "name": "kanagawa-vscode",
  "displayName": "Kanagawa Language Support",
  "description": "Language support for Kanagawa (LSP-Lite)",
  "version": "0.0.1",
  "publisher": "microsoft",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:kanagawa",
    "onCommand:kanagawa.index.clear",
    "onCommand:kanagawa.index.rebuild",
    "onCommand:kanagawa.index.toggleVerbose",
    "onCommand:kanagawa.index.showStats",
    "onCommand:kanagawa.typePeek.show",
    "onCommand:kanagawa.outline.selectCategories",
    "onCommand:kanagawa.outline.setModulePrefix",
    "onCommand:kanagawa.outline.clearModulePrefix"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "kanagawa",
        "aliases": [
          "Kanagawa",
          "kanagawa"
        ],
        "extensions": [
          ".k",
          ".pd"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "commands": [
      {
        "command": "kanagawa.index.clear",
        "title": "Kanagawa: Clear Index",
        "category": "Kanagawa"
      },
      {
        "command": "kanagawa.index.rebuild",
        "title": "Kanagawa: Rebuild Index",
        "category": "Kanagawa"
      },
      {
        "command": "kanagawa.index.toggleVerbose",
        "title": "Kanagawa: Toggle Index Verbose Logging",
        "category": "Kanagawa"
      },
      {
        "command": "kanagawa.index.showStats",
        "title": "Kanagawa: Show Index Stats",
        "category": "Kanagawa"
      },
      {
        "command": "kanagawa.typePeek.show",
        "title": "Kanagawa: Show Inferred Type",
        "category": "Kanagawa"
      },
      {
        "command": "kanagawa.outline.selectCategories",
        "title": "Kanagawa: Select Outline Categories",
        "category": "Kanagawa"
      },
      {
        "command": "kanagawa.outline.setModulePrefix",
        "title": "Kanagawa: Set Outline Module Prefix",
        "category": "Kanagawa"
      },
      {
        "command": "kanagawa.outline.clearModulePrefix",
        "title": "Kanagawa: Clear Outline Module Prefix",
        "category": "Kanagawa"
      },
      {
        "command": "kanagawa.perf.toggle",
        "title": "Kanagawa: Toggle Performance Logging",
        "category": "Kanagawa"
      },
      {
        "command": "kanagawa.perf.showSummary",
        "title": "Kanagawa: Show Performance Summary",
        "category": "Kanagawa"
      },
      {
        "command": "kanagawa.perf.clear",
        "title": "Kanagawa: Clear Performance Stats",
        "category": "Kanagawa"
      },
      {
        "command": "kanagawa.perf.setThreshold",
        "title": "Kanagawa: Set Slow Operation Threshold",
        "category": "Kanagawa"
      },
      {
        "command": "kanagawa.deps.showCurrent",
        "title": "Kanagawa: Show Module Dependencies",
        "category": "Kanagawa"
      },
      {
        "command": "kanagawa.deps.showFull",
        "title": "Kanagawa: Show Full Dependency Graph",
        "category": "Kanagawa"
      },
      {
        "command": "kanagawa.deps.showInteractive",
        "title": "Kanagawa: Browse Module Dependencies",
        "category": "Kanagawa"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "kanagawa.config.json",
        "url": "./kanagawa.config.schema.json"
      }
    ],
    "configuration": {
      "title": "Kanagawa",
      "properties": {
        "kanagawa.outline.categoryFilter": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "module",
              "class",
              "struct",
              "union",
              "enum",
              "function",
              "method",
              "variable",
              "member",
              "constant",
              "alias",
              "other"
            ]
          },
          "default": [],
          "description": "Outline categories to display. Leave empty to show all categories."
        },
        "kanagawa.outline.modulePrefix": {
          "type": "string",
          "default": "",
          "description": "Only show symbols whose module path starts with this prefix."
        },
        "kanagawa.typePeek.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Show 'type: ...' CodeLens above 'auto' variable declarations. Disabled by default since inlay hints provide the same information inline."
        },
        "kanagawa.inlayHints.typeHints.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show inferred type hints for 'auto' variable declarations."
        },
        "kanagawa.inlayHints.parameterNames.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show parameter name hints at function call sites."
        },
        "kanagawa.inlayHints.templateParameterNames.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show template parameter name hints at template instantiation sites."
        },
        "kanagawa.signatureHelp.templateParameters.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show template parameter signature help when typing template arguments (triggered by '<')."
        },
        "kanagawa.compiler.importPaths": {
          "type": "array",
          "scope": "resource",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Additional search paths for Kanagawa imports. Relative paths are resolved against the workspace folder. Workspace kanagawa.config.json entries are merged first, followed by these settings.",
          "tags": [
            "kanagawa"
          ]
        },
        "kanagawa.compiler.stdlibPath": {
          "type": "string",
          "scope": "resource",
          "default": "",
          "markdownDescription": "Optional override for the standard library location. Relative paths are resolved against the workspace folder. Values in these settings take precedence over workspace kanagawa.config.json entries.",
          "tags": [
            "kanagawa"
          ]
        },
        "kanagawa.index.exclude": {
          "type": "array",
          "scope": "resource",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Glob patterns for files and folders to exclude from indexing. Patterns are matched against paths relative to the workspace folder. Examples: `**/generated/**`, `**/*.gen.k`, `test_vectors/**`.",
          "tags": [
            "kanagawa"
          ]
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "compile:test": "tsc -p ./tsconfig.test.json",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run compile:test",
    "lint": "eslint src --ext ts",
    "test": "mocha ./out/test/**/*.test.js --timeout 10000",
    "test:grammar": "cd grammar && npx tree-sitter test"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/glob": "^8.0.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "16.x",
    "@types/vscode": "^1.74.0",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "@vscode/test-electron": "^2.2.0",
    "chai": "^6.2.1",
    "eslint": "^8.28.0",
    "glob": "^8.0.3",
    "mocha": "^10.1.0",
    "typescript": "^4.9.3"
  },
  "dependencies": {
    "web-tree-sitter": "^0.20.8"
  }
}
