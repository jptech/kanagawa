{
  "name": "tree-sitter-kanagawa",
  "version": "0.0.1",
  "description": "Kanagawa grammar for tree-sitter",
  "main": "bindings/node",
  "keywords": [
    "parsing",
    "incremental"
  ],
  "dependencies": {
    "nan": "^2.14.2"
  },
  "devDependencies": {
    "tree-sitter-cli": "^0.20.8"
  },
  "tree-sitter": [
    {
      "scope": "source.kanagawa",
      "file-types": [
        "k"
      ],
      "injection-regex": "^kanagawa$"
    }
  ]
}
